# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.local
.env.*.local

# Session state (per-machine, don't commit)
sessions.json
sessions.json.tmp

# Workspace — files the agent creates live here.
# Keep the folder in the repo, ignore its contents.
workspace/*
!workspace/.gitkeep

# Backups you might create during refactors
*.bak
*.backup

# Logs
*.log
logs/
npm-debug.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Build output (in case you add a build step later)
dist/
build/
coverage/
.cache/

# Test output
*.test.log

# Docker-related local state
docker-compose.override.yml